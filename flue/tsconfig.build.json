{
	// Emits the adapter and the core modules it imports as JavaScript, so an app can install
	// pi-hydra and load `pi-hydra/flue` with plain Node and its own copy of Flue.
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "..",
		"outDir": "dist",
		"declaration": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"files": ["index.ts"]
}
